{
  "name": "print-js",
  "homepage": "http://printjs.crabbly.com",
  "description": "A tiny javascript library to help printing from the web.",
  "version": "1.6.0",
  "main": "dist/print.js",
  "types": "src/index.d.ts",
  "repository": "https://github.com/crabbly/Print.js",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "7.11.6",
    "@babel/preset-env": "7.11.5",
    "babel-loader": "8.1.0",
    "babel-plugin-istanbul": "^7.0.0",
    "coveralls": "3.1.0",
    "css-loader": "4.2.2",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "jasmine-core": "3.6.0",
    "karma": "5.2.3",
    "karma-chrome-launcher": "3.1.0",
    "karma-coverage": "2.0.3",
    "karma-jasmine": "4.0.1",
    "karma-phantomjs-launcher": "1.0.4",
    "karma-sourcemap-loader": "0.3.8",
    "karma-webpack": "5.0.0",
    "mini-css-extract-plugin": "0.11.0",
    "sass": "^1.63.6",
    "sass-loader": "10.0.2",
    "standard": "14.3.4",
    "terser-webpack-plugin": "4.1.0",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  },
  "scripts": {
    "test": "standard && karma start",
    "dev": "webpack --mode development --progress --devtool source-map",
    "watch": "webpack --mode development --watch --progress",
    "prepare": "webpack --mode production --progress",
    "coverage": "open coverage/lcov-report/index.html",
    "coveralls": "cat coverage/lcov.info | ./node_modules/coveralls/bin/coveralls.js",
    "start": "webpack-dev-server --public http://localhost:8080/test/manual --open",
    "standard:fix": "standard --fix"
  },
  "author": "Rodrigo Vieira <rodrigo@crabbly.com>",
  "standard": {
    "ignore": [
      "/dist/print.js"
    ],
    "env": {
      "browser": true,
      "jasmine": true
    }
  },
  "keywords": [
    "printjs",
    "print.js",
    "print-js"
  ]
}
